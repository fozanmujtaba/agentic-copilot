# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real keys.

# ---------------------------------------------------------------------------
# LLM provider: groq | gemini | cerebras | ollama
# Only the selected provider's key is required.
# ---------------------------------------------------------------------------
LLM_PROVIDER=groq

# Optional — overrides the provider's default model (see DEFAULT_MODELS in llm.py)
# LLM_MODEL=llama-3.3-70b-versatile

# Groq (default) -> https://console.groq.com/keys  — free tier, no card
GROQ_API_KEY=your-groq-api-key-here

# Google AI Studio -> https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Cerebras -> https://cloud.cerebras.ai  (requires: pip install langchain-cerebras)
# CEREBRAS_API_KEY=your-cerebras-api-key-here

# Ollama needs no key — just `ollama pull llama3.1:8b`
# (requires: pip install langchain-ollama)

# ---------------------------------------------------------------------------
# Tracing
# ---------------------------------------------------------------------------
# LangSmith -> https://smith.langchain.com/ (Settings -> API Keys)
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=agentic-copilot
